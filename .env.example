# ============================================================
# Médico 360 — Environment Variables (example — sem valores reais)
# Copie para .env e preencha com seus valores
# ============================================================

# --- App ---
# Sem padrão de propósito: falta de APP_ENV derruba o startup com mensagem
# clara, em vez de rodar em modo dev por engano em produção.
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# --- JWT Auth ---
JWT_SECRET_KEY=seu_secret_key_aqui_minimo_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Provider API Keys ---
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-svcacct-...
GOOGLE_AI_API_KEY=...
PERPLEXITY_API_KEY=pplx-...
PHARMADB_API_KEY=pdb_...
PUBMED_API_KEY=...

# --- SendGrid ---
# Obrigatório em produção (fail-fast no startup se vazio com APP_ENV=production).
SENDGRID_API_KEY=SG....
SENDGRID_FROM_EMAIL=noreply@medico360.com.br

# --- Auth / URLs de front ---
FRONTEND_URL=http://localhost:5173
CALCULADORAS_URL=http://localhost:5174
INVITE_TOKEN_EXPIRE_HOURS=72
OTP_EXPIRE_MINUTES=10
ALLOW_PUBLIC_REGISTRATION=false
# Domínio do cookie de sessão (ex.: .medico360.com.br). Vazio = host-only.
COOKIE_DOMAIN=

# --- Embed SSO ---
# Lista JSON de origens autorizadas a abrir o embed (ex.: '["https://a.com","https://b.com"]").
# Default no código cobre o único parceiro atual (Curseduca); só precisa
# sobrescrever aqui para adicionar novos parceiros sem alterar código.
EMBED_ALLOWED_ORIGINS=

# Validação server-to-server de membro Curseduca (plano 2.1). OBRIGATÓRIO
# =true em produção: sem ela, o /auth/embed/token confia só no header Origin
# (forjável) e emite JWT para qualquer e-mail informado.
CURSEDUCA_VALIDATION_ENABLED=false
CURSEDUCA_API_BASE=https://prof.curseduca.pro
CURSEDUCA_API_KEY=
CURSEDUCA_ACCESS_TOKEN=

# --- Landing Pages ---
# Cada LP (lp-financas, lp-contabilidade, lp-parceiros, ...) tem seu próprio
# domínio Railway; aceita JSON array, CSV ou uma única URL.
LANDING_PAGES_ORIGINS=["http://localhost:5175","http://localhost:5176","http://localhost:5177"]

# --- Intercom (Identity Verification / Messenger Security) ---
# Secret do Web SDK, usado para gerar o user_hash (HMAC) do Messenger.
INTERCOM_IDENTITY_SECRET=

# --- Redis ---
REDIS_URL=redis://default:password@host:port

# --- Rastreamento de erro (Sentry) ---
# Vazio DESLIGA o Sentry por completo — a aplicação sobe normalmente sem ele.
# Para ativar: crie um projeto em sentry.io (ou numa instância própria de
# GlitchTip, que é compatível) e cole o DSN aqui.
#
# O scrubbing de PII em `app/core/error_tracking.py` é obrigatório e testado:
# sem ele o prompt clínico bruto sairia em cada evento de erro. Não desative.
SENTRY_DSN=
# Opcional: identifica a versão nos eventos. Use o hash do commit no deploy.
SENTRY_RELEASE=
# Fração das requisições amostradas como transação (0.0 a 1.0). É o que dá a
# taxa de resposta por rota — a leitura que separa "401 é o fluxo normal do
# embed" de "401 em toda chamada desta rota". No plano free a cota de
# transações é pequena e amostrar demais a queima em dias; 0.05 descreve
# tendência no volume atual. Ao crescer o tráfego, BAIXE (a amostra por rota
# continua grande); ao escalar o plano, suba. 0.0 desliga.
SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Observabilidade (Arize Phoenix) ---
# Vazio desliga a observabilidade — mesma lógica do Sentry.
# Não defina PHOENIX_COLLECTOR_ENDPOINT: app/core/telemetry.py deriva essa var
# automaticamente a partir do PHOENIX_ENDPOINT abaixo (convenção do SDK do
# Phoenix) — setar as duas manualmente é redundante.
PHOENIX_API_KEY=
PHOENIX_PROJECT_NAME=medico-360
PHOENIX_ENDPOINT=https://app.phoenix.arize.com/s/ruben-nogueira

# --- Agregador de modelos ---
MAX_MODELS_PER_QUERY=4
MAX_PROMPT_CHARS=4000
DEFAULT_TIMEOUT_SECONDS=30

# --- Calculadoras ---
CALCULATOR_TEXT_FIELD_MAX_CHARS=2000
CALCULATOR_CATALOG_CACHE_TTL_SECONDS=300
CALCULATOR_EXTRACTION_MAX_CONCURRENCY=8
CALCULATOR_EXTRACTION_TIMEOUT_SECONDS=15

# --- Notícias (feed de destaques dos journals) ---
# Frontend do módulo (noticias-app). Usado nos links do digest por e-mail.
NOTICIAS_URL=http://localhost:5176
# Desliga o pipeline agendado sem precisar remover código. Útil em dev e para
# parar a coleta em produção sem deploy.
NEWS_ENABLED=true
# A NCBI pede que ferramentas automatizadas se identifiquem. Sem isso, um pico
# de tráfego nosso vira bloqueio por IP sem que ninguém consiga nos avisar antes.
# A chave em si é a PUBMED_API_KEY acima — uma só, compartilhada com o validador
# de citações do orquestrador, porque o rate limit da NCBI é por chave.
NCBI_CONTACT_EMAIL=
# Horários em UTC. 11 = 8h BRT, depois de os journals publicarem o número do dia;
# o digest roda 1h depois, para o pipeline já ter terminado.
NEWS_RUN_HOUR=11
NEWS_DIGEST_HOUR=12

# DOIS LIMIARES, DE PROPÓSITO: navegar é barato, interromper é caro. O mesmo
# score que justifica um artigo aparecer na lista não justifica um e-mail.
# Ambos vivem aqui porque nascem como chute e vão precisar de calibragem com
# dado real — e calibrar não pode exigir deploy.
NEWS_FEED_SCORE_MINIMO=0.3
NEWS_DIGEST_SCORE_MINIMO=0.6
# Abaixo deste número de itens, o feed completa com temas adjacentes à
# especialidade, marcados como preenchimento (e ignorados pelo digest).
NEWS_FEED_MINIMO_ITENS=5
NEWS_FEED_JANELA_DIAS=30
NEWS_DIGEST_JANELA_DIAS=2

# --- Palavras-chave do médico (eixo separado dos temas) ---
# Casam contra o TEXTO do artigo, não contra o que o tagger atribuiu. Ver
# app/services/news_keyword_service.py para o porquê de não serem "mais um tema".
NEWS_MAX_KEYWORDS=10
NEWS_KEYWORD_MIN_CHARS=4
NEWS_KEYWORD_RANK_MINIMO=0.05

# --- Sugestão social de temas ---
# Abaixo deste número de usuários da especialidade, a tela de temas diz
# "Selecionamos para quem é de X"; acima, "O que os colegas de X mais acompanham"
# com percentuais reais. A troca é automática — sem deploy.
NEWS_MIN_AMOSTRA_SOCIAL=20
# Modelo do redator de notícias. Configurável de propósito: o módulo antigo já
# rodava com este valor sobrescrito em produção, e transformá-lo em constante no
# código rebaixaria o redator sem ninguém perceber.
NEWS_WRITER_MODEL=claude-sonnet-5
