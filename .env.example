# ============================================================
# Médico 360 — Environment Variables (example — sem valores reais)
# Copie para .env e preencha com seus valores
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# --- JWT Auth ---
JWT_SECRET_KEY=seu_secret_key_aqui_minimo_32_chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI Provider API Keys ---
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-svcacct-...
GOOGLE_AI_API_KEY=...
PERPLEXITY_API_KEY=pplx-...
PHARMADB_API_KEY=pdb_...

# --- Redis ---
REDIS_URL=redis://default:password@host:port

# --- App Settings ---
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO

FRONTEND_URL=http://localhost:5175

# --- Rastreamento de erro (Sentry) ---
# Vazio DESLIGA o Sentry por completo — a aplicação sobe normalmente sem ele.
# Para ativar: crie um projeto em sentry.io (ou numa instância própria de
# GlitchTip, que é compatível) e cole o DSN aqui.
#
# O scrubbing de PII em `app/core/error_tracking.py` é obrigatório e testado:
# sem ele o prompt clínico bruto sairia em cada evento de erro. Não desative.
SENTRY_DSN=
# Opcional: identifica a versão nos eventos. Use o hash do commit no deploy.
SENTRY_RELEASE=
