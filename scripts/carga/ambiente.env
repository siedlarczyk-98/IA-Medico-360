# Ambiente do teste de carga LOCAL. Só valores falsos — nada aqui é segredo.
# Usado por `subir_ambiente.sh` com `docker run --env-file`.

# production de propósito: é o que manda o limitador para o Redis e liga o
# endurecimento (cookie Secure, validação da Waid) como no Railway.
APP_ENV=production
LOG_LEVEL=WARNING

DATABASE_URL=postgresql+asyncpg://postgres:carga@m360-carga-db:5432/m360
REDIS_URL=redis://m360-carga-redis:6379/0
JWT_SECRET_KEY=carga-local-nao-e-segredo-0123456789abcdef

# Interceptador: sem as duas linhas abaixo o backend chamaria os provedores DE
# VERDADE com chaves falsas (e levaria 401 em tudo).
PYTHONPATH=/app/scripts/carga/interceptador
CARGA_FALSO_URL=http://m360-carga-falso:9000

ANTHROPIC_API_KEY=falso
OPENAI_API_KEY=falso
GOOGLE_AI_API_KEY=falso
PERPLEXITY_API_KEY=falso
MARITACA_API_KEY=falso
PHARMADB_API_KEY=falso
# Com chave, a cadência do PubMed é 8/s por processo; sem, 2,5/s.
PUBMED_API_KEY=falso
SENDGRID_API_KEY=falso

CURSEDUCA_VALIDATION_ENABLED=true
CURSEDUCA_API_KEY=falso
CURSEDUCA_ACCESS_TOKEN=falso
EMBED_ALLOWED_ORIGINS=["https://www.medico360.app"]

DEA_IP_HASH_SALT=falso
# O pipeline de notícias roda no líder de hora em hora; fora do teste, é ruído.
NEWS_ENABLED=false
